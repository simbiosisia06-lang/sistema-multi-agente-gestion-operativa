# =================================================================
# Configuración del Entorno - Sistema Multi-Agente de Gestión Operativa
# Copiar este archivo a .env y ajustar los valores antes de iniciar los servicios:
# cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# 1. Configuración de n8n
# -----------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
# Generar una clave de cifrado segura de 32 caracteres (ejemplo ficticio):
N8N_ENCRYPTION_KEY=mock_encryption_key_abcdef1234567890
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires

# -----------------------------------------------------------------
# 2. Configuración de NocoDB
# -----------------------------------------------------------------
NOCODB_PORT=8080
NC_PUBLIC_URL=http://localhost:8080
# SQLite embebido por defecto (o string de conexión a PostgreSQL/MySQL si se requiere):
NC_DB=sqlite3:/usr/app/data/noco.db
# Token JWT seguro ficticio para sesiones de NocoDB:
NC_AUTH_JWT_SECRET=mock_jwt_secret_token_1234567890abcdef

# Token de API generado en NocoDB para vincular con las herramientas de n8n:
NOCODB_API_TOKEN=mock_nocodb_api_token_value_placeholder

# -----------------------------------------------------------------
# 3. Inferencia Local (Ollama / Local LLM)
# -----------------------------------------------------------------
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434

# Credenciales de API OpenAI-compatible para nodos LangChain en n8n
# (Para endpoints locales de Ollama / LocalAI / LM Studio se puede utilizar un token simulado):
OPENAI_API_KEY=mock_openai_compatible_api_key_or_ollama
OPENAI_API_BASE=http://ollama:11434/v1
